# Copy this file to .env.local and fill in the two values from your Supabase
# project: Dashboard -> Project Settings -> API.
#
# The anon key is safe to ship in the browser. Row Level Security is what
# actually guards the data. NEVER put the service_role key in here.

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
